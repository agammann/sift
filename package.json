{
  "name": "sift-local",
  "version": "0.1.0",
  "description": "Clean documentation. Clear sources. Local documentation collections and read-only MCP access.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "sift": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "migrations",
    "examples",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/cli.js start",
    "dev": "pnpm run build && pnpm start",
    "release": "node scripts/release.mjs",
    "verify:package": "node scripts/install-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "robots-parser": "3.0.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
